+    /**
+     * A process-independent digest of the conversation history.
+     *
+     * <p>Each turn contributes its role's name, its content's length and its
+     * content, in order. The role name (not the enum's hash) keeps the value
+     * identical in every JVM; order and role are both significant, so
+     * {@code [USER a, USER b]} differs from {@code [USER b, USER a]} and
+     * {@code USER a} from {@code ASSISTANT a}. The length prefix keeps the
+     * rendering unambiguous even if content contains the separators.
+     */
+    private String historyDigest(List<Message> history) {
+        if (history == null || history.isEmpty()) {
+            return "";
+        }
+        StringBuilder rendered = new StringBuilder();
+        for (Message message : history) {
+            String content = message.content();
+            rendered.append(message.role().name()).append(UNIT_SEPARATOR)
+                    .append(content.length()).append(':').append(content)
+                    .append(RECORD_SEPARATOR);
+        }
+        return sha256(rendered.toString());
+    }
